<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:textColor="#E7EAF0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="#0B0D12"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/widget_badge_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E7EAF0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="근무 정보 없음" />

            <TextView
                android:id="@+id/widget_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8992A6"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8992A6"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
