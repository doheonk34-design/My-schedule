rules_version = '2';

// 교대노트 Firestore 보안 규칙
// - 문서 id(8자리 코드)를 아는 사람만 읽고 쓸 수 있음 (코드가 곧 열쇠)
// - 목록 조회(list)는 금지: 예전 규칙에서는 API 키만으로 전체 코드·메모를 모두 나열할 수 있었음
// - 정해진 필드/형식만 저장 가능, 그 외 컬렉션은 전부 차단
service cloud.firestore {
  match /databases/{database}/documents {

    function validCode(code) {
      return code.matches('^[A-HJ-NP-Z2-9]{8}$');
    }

    // 기기 간 동기화 (전체 데이터)
    match /shiftNoteSync/{code} {
      allow get: if validCode(code);
      allow list: if false;
      allow create, update: if validCode(code)
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'clientUpdatedAt'])
        && request.resource.data.payload is map;
      allow delete: if validCode(code);
    }

    // 공유 링크 / 캘린더 구독 / 아이폰 알람 계획 (읽기 전용으로 바깥에 나가는 문서)
    match /shiftNoteShare/{code} {
      allow get: if validCode(code);
      allow list: if false;
      allow create, update: if validCode(code)
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'kind', 'label', 'plan', 'prefix', 'validFrom', 'validUntil'])
        && request.resource.data.kind in ['share_link', 'calendar_subscription_work', 'calendar_subscription_memo', 'iphone_alarm_plan'];
      allow delete: if validCode(code);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
